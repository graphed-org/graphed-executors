# Coverage for the `test-htcondor` CI job: the main matrix omits `*/htcondor_backend/*`, and this job
# measures it from the m66 suite, including the local pilot subprocesses (parallel + sigterm, as in
# `.coveragerc-parsl`).
[run]
branch = true
parallel = true
sigterm = true
source =
    graphed_executors.htcondor_backend

[report]
fail_under = 90
show_missing = true
